# Public production URL, without a trailing slash.
VITE_SITE_URL=https://example.com

# Public support inbox shown on the contact page.
VITE_CONTACT_EMAIL=7yvexon@gmail.com

# Server-only secrets. Add these in Netlify environment variables and never
# prefix them with VITE_ or commit real values to this file.
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-characters
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-in-netlify-only
