{
  "name": "toolbox-kr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-routes.mjs",
    "build:production": "node scripts/check-production-env.mjs && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run test && npm run build && npm run security:audit",
    "check:offline": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@rhwp/core": "^0.8.2",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pretendard": "^1.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
